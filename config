#!/bin/bash
# The pi-gen config for a build on your own machine (setup_local_test_environment.sh copies it
# into ./pi-gen and adds the versions). The build workflow does not use this file: there the
# pi-gen action writes the config from its inputs. Keep the two in step.
# shellcheck disable=SC2034  # pi-gen reads these values

IMG_NAME="Homebridge"
TARGET_HOSTNAME="homebridge"
ENABLE_SSH=1
STAGE_LIST="stage0 stage1 stage2 stage3_homebridge"
#FIRST_USER_NAME="pi"
#FIRST_USER_PASS="raspberry"
RELEASE="trixie"
#CONTINUE=1