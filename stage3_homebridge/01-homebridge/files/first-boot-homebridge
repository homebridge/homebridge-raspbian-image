#!/bin/sh
#
# Runs once, at the first boot of a new image.
#
# WiFi that was set in Raspberry Pi Imager needs nothing here: Imager saves it in NetworkManager,
# and wifi-connect does not start its setup hotspot when a WiFi network is saved.

# Show the Raspberry Pi model on the login screen (/etc/issue)
if [ -f /proc/device-tree/model ]; then
  RPI_MODEL=$(tr -d '\0' < /proc/device-tree/model)
  if [ -n "$RPI_MODEL" ]; then
    sed -i "2iRPI Model: \\\e{yellow}${RPI_MODEL}\\\e{reset}" /etc/issue
  fi
fi

# disable this service so it does not run again
systemctl disable first-boot-homebridge
systemctl daemon-reload
