#!/bin/sh

INTERACTIVE=True
ASK_TO_REBOOT=0

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\e[1m'
NC='\033[0m'

is_pi () {
  ARCH=$(dpkg --print-architecture)
  if [ "$ARCH" = "armhf" ] || [ "$ARCH" = "arm64" ] ; then
    return 0
  else
    return 1
  fi
}

is_pione() {
   if grep -q "^Revision\s*:\s*00[0-9a-fA-F][0-9a-fA-F]$" /proc/cpuinfo; then
      return 0
   elif grep -q "^Revision\s*:\s*[ 123][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]0[0-36][0-9a-fA-F]$" /proc/cpuinfo ; then
      return 0
   else
      return 1
   fi
}

is_pitwo() {
   grep -q "^Revision\s*:\s*[ 123][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]04[0-9a-fA-F]$" /proc/cpuinfo
   return $?
}

is_pizero() {
   grep -q "^Revision\s*:\s*[ 123][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]0[9cC][0-9a-fA-F]$" /proc/cpuinfo
   return $?
}

is_pifour() {
   grep -q "^Revision\s*:\s*[ 123][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]11[0-9a-fA-F]$" /proc/cpuinfo
   return $?
}

get_pi_type() {
   if is_pione; then
      echo 1
   elif is_pitwo; then
      echo 2
   else
      echo 0
   fi
}

is_live() {
    grep -q "boot=live" $CMDLINE
    return $?
}

is_ssh() {
  if pstree -p | egrep --quiet --extended-regexp ".*sshd.*\($$\)"; then
    return 0
  else
    return 1
  fi
}

is_fkms() {
  if grep -q okay /proc/device-tree/soc/v3d@7ec00000/status 2> /dev/null || grep -q okay /proc/device-tree/soc/firmwarekms@7e600000/status 2> /dev/null ; then
    return 0
  else
    return 1
  fi
}

deb_ver () {
  ver=`cat /etc/debian_version | cut -d . -f 1`
  echo $ver
}

calc_wt_size() {
  # NOTE: it's tempting to redirect stderr to /dev/null, so supress error
  # output from tput. However in this case, tput detects neither stdout or
  # stderr is a tty and so only gives default 80, 24 values
  WT_HEIGHT=17
  WT_WIDTH=$(tput cols)

  if [ -z "$WT_WIDTH" ] || [ "$WT_WIDTH" -lt 60 ]; then
    WT_WIDTH=80
  fi
  if [ "$WT_WIDTH" -gt 178 ]; then
    WT_WIDTH=120
  fi
  WT_MENU_HEIGHT=$(($WT_HEIGHT-7))
}

get_web_addresses() {
  IP=$(hostname -I)

  printf "  ${BOLD}*${NC} ${GREEN}$1://$(hostname).local:$2$3${NC}\n"

  for ip in $IP; do
    if expr "$ip" : '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$' >/dev/null; then
      printf "  ${BOLD}*${NC} ${GREEN}$1://$ip:$2$3${NC}\n"
    else
      printf "  ${BOLD}*${NC} ${GREEN}$1://[$ip]:$2$3${NC}\n"
    fi
  done
}

do_finish() {
  if [ $ASK_TO_REBOOT -eq 1 ]; then
    whiptail --yesno "Would you like to reboot now?" 20 60 2
    if [ $? -eq 0 ]; then # yes
      sync
      reboot
    fi
  fi
  exit 0
}

HB_KEYRING=/usr/share/keyrings/homebridge.gpg
HB_APT_LIST=/etc/apt/sources.list.d/homebridge.list

# Prints the Homebridge package channel this system uses (stable, beta, alpha or legacy).
# It is read from the apt source file, so a user who chose beta stays on beta.
hb_apt_channel() {
  HB_CHANNEL=""
  if [ -f "$HB_APT_LIST" ]; then
    HB_CHANNEL=$(sed -n 's#^deb .*https://repo\.homebridge\.io/* \([a-z]*\) main.*#\1#p' "$HB_APT_LIST" | head -n 1)
  fi
  case "$HB_CHANNEL" in
    stable | beta | alpha | legacy) ;;
    *) HB_CHANNEL=stable ;;
  esac
  printf '%s\n' "$HB_CHANNEL"
}

# Downloads the key of the Homebridge package repo and writes the apt source file.
# The key in use is only replaced when the new one was downloaded and converted in full.
# Returns 1, and changes nothing, when that fails (for example with no network).
hb_refresh_apt_source() {
  HB_TMP=$(mktemp -d) || return 1
  if curl -sSfL https://repo.homebridge.io/KEY.gpg -o "$HB_TMP/KEY.gpg" \
    && gpg --dearmor < "$HB_TMP/KEY.gpg" > "$HB_TMP/homebridge.gpg" \
    && [ -s "$HB_TMP/homebridge.gpg" ]; then
    HB_CHANNEL=$(hb_apt_channel)
    install -m 644 "$HB_TMP/homebridge.gpg" "$HB_KEYRING"
    echo "deb [signed-by=$HB_KEYRING] https://repo.homebridge.io $HB_CHANNEL main" > "$HB_APT_LIST"
    rm -rf "$HB_TMP"
    return 0
  fi
  rm -rf "$HB_TMP"
  return 1
}

do_homebridge_update() {
  if pstree -s $$ | grep -q "hb-service"; then
    whiptail --title "Error" --msgbox "You cannot run this command from the Homebridge UI Terminal.\n\nPlease connect using SSH (see wiki for instructions) and try again." 20 60 1
    printf "\n"
    return
  fi

  if ! hb_refresh_apt_source; then
    whiptail --title "Error" --msgbox "The key of the Homebridge package repo could not be downloaded.\n\nCheck the network connection and try again. Nothing was changed." 20 60 1
    return
  fi

  if ! apt-get update --allow-releaseinfo-change; then
    whiptail --title "Error" --msgbox "The package lists could not be updated.\n\nCheck the network connection and try again. Homebridge was not changed." 20 60 1
    return
  fi

  if ! apt-get install -y homebridge; then
    whiptail --title "Error" --msgbox "The Homebridge package could not be updated. Review the log above." 20 60 1
  fi
}

do_restore_config() {
  if pstree -s $$ | grep -q "hb-service"; then
    whiptail --title "Error" --msgbox "You cannot run this command from the Homebridge UI Terminal.\n\nPlease connect using SSH (see wiki for instructions) and try again." 20 60 1
    printf "\n"
    return
  fi

  if ! whiptail --defaultno --yesno "This will DELETE ALL Homebridge data on this device:\n\n* the Homebridge config\n* all plugins and their settings\n* the accessory cache\n* the backups stored on this device\n\nHomebridge is then installed again with its default settings. You will need to manually remove any existing connections to this instance in the iOS Home app.\n\nAre you sure you want to proceed?" 20 60 2; then
    return
  fi

  # Nothing is deleted before the package is on this device again: the key, the package lists
  # and the package file are downloaded first. With no network, this stops here.
  if ! hb_refresh_apt_source \
    || ! apt-get update --allow-releaseinfo-change \
    || ! apt-get install -y --download-only --reinstall homebridge; then
    whiptail --title "Error" --msgbox "The Homebridge package could not be downloaded.\n\nCheck the network connection and try again. Nothing was deleted." 20 60 1
    return
  fi

  apt-get purge -y homebridge

  if ! apt-get install -y homebridge; then
    whiptail --title "Error" --msgbox "Homebridge was removed, but it could not be installed again. Review the log above, then run:\n\nsudo apt-get install homebridge" 20 60 1
  fi
}

do_nodejs_update() {
  hb-service update-node
  exit 0
}

do_install_pihole() {
  if pstree -s $$ | grep -q "hb-service"; then
    whiptail --title "Error" --msgbox "You must not install Pi Hole via the Homebridge UI Terminal.\n\nFor a successful installation of Pi-Hole you must be logged in using SSH (see wiki for instructions)." 20 60 1
    printf "\n"
    return
  fi

  if ! whiptail --title "Warning" --yesno "Installing Pi-Hole will prevent you from accessing the Homebridge UI on port 80.\n\nYou will still be able to access the Homebridge UI on port $(cat /etc/hb-ui-port) and via:\n\n* http://homebridge.local:$(cat /etc/hb-ui-port)\n* https://homebridge.local\n\nWARNING: Failing to configure Pi-Hole correctly or attempting to uninstall Pi-Hole may result in Homebridge not working correctly. You should take a backup of your Homebridge instance via the UI before proceeding.\n\nAre you sure you want to continue?" 20 60 1; then
    return
  fi

  # Pi-hole needs port 80. The Homebridge nginx config gives it up while the installer runs.
  # A copy is kept, so port 80 can be given back if Pi-hole is not installed after all.
  NGINX_SITE=/etc/nginx/sites-available/homebridge.local
  NGINX_SITE_COPY=""
  if [ -f "$NGINX_SITE" ]; then
    NGINX_SITE_COPY=$(mktemp) || return 1
    cat "$NGINX_SITE" > "$NGINX_SITE_COPY"
    sed -i "/listen 80;/c\  # listen 80;                  # http IPv4 - disabled by Pi-Hole installer" "$NGINX_SITE"
    sed -i "/listen \[::\]:80;/c\  # listen \[::\]:80;             # http IPv6 - disabled by Pi-Hole installer" "$NGINX_SITE"
    if systemctl is-active --quiet nginx.service; then
      echo "Restarting Nginx..."
      systemctl restart nginx
    fi
  fi

  printf "Starting Pi-hole installer...\n"
  PIHOLE_INSTALLER=$(mktemp) || return 1
  if curl -sSfL https://install.pi-hole.net -o "$PIHOLE_INSTALLER" && bash "$PIHOLE_INSTALLER"; then
    rm -f "$PIHOLE_INSTALLER" "$NGINX_SITE_COPY"

    printf "\n${BOLD}Pi-hole has been installed${NC}\n"
    printf "Access Pi-hole in your browser by going to:\n"
    get_web_addresses http 80 /admin

    printf "\nYou can still access the Homebridge UI by going to:\n"
    get_web_addresses http "$(cat /etc/hb-ui-port)"
    get_web_addresses https 443
    printf "\n"
    exit 0
  fi

  rm -f "$PIHOLE_INSTALLER"

  # The installer was cancelled or failed: give port 80 back to the Homebridge UI.
  if [ -n "$NGINX_SITE_COPY" ]; then
    cat "$NGINX_SITE_COPY" > "$NGINX_SITE"
    rm -f "$NGINX_SITE_COPY"
    if systemctl is-active --quiet nginx.service; then
      echo "Restarting Nginx..."
      systemctl restart nginx
    fi
  fi

  whiptail --title "Error" --msgbox "Pi-hole was NOT installed: the installer was cancelled or it failed. Review the log above.\n\nThe Homebridge UI is on port 80 again." 20 60 1
  printf "\n"
}

do_install_adguard_home() {
  if [ -e /etc/systemd/system/AdGuardHome.service ]; then
    if whiptail --title "Remove AdGuard Home" --yesno "AdGuard Home is already installed.\n\nWould you like to UNINSTALL AdGuard Home?" 20 60 1; then
      systemctl stop AdGuardHome
      systemctl disable AdGuardHome
      rm -rf /etc/systemd/system/AdGuardHome.service
      rm -rf /opt/AdGuardHome
      systemctl daemon-reload
      whiptail --title "Success" --msgbox "AdGuard Home has been uninstalled." 20 60 1
      printf "\n"
    fi
    return
  fi

  if ! whiptail --title "Warning" --yesno "This will install the AdGuard Home software which uses the following ports:\n\n* 3000\n\nAre you sure you want to continue?" 20 60 1; then
    return
  fi

  # AdGuard Home publishes a build for each architecture - use the one for this system
  case "$(dpkg --print-architecture)" in
    arm64) ADGUARD_ARCH="arm64" ;;
    *) ADGUARD_ARCH="armv7" ;;
  esac

  # The download goes into a new folder that only root can use. A fixed name in /tmp could be
  # prepared by another user before this runs.
  ADGUARD_TMP=$(mktemp -d) || return 1

  if ! wget -O "$ADGUARD_TMP/AdGuardHome.tar.gz" "https://static.adguard.com/adguardhome/release/AdGuardHome_linux_${ADGUARD_ARCH}.tar.gz" \
    || ! tar xf "$ADGUARD_TMP/AdGuardHome.tar.gz" -C /opt/; then
    rm -rf "$ADGUARD_TMP"
    whiptail --title "Error" --msgbox "AdGuard Home could not be downloaded or unpacked.\n\nCheck the network connection and try again. Nothing was installed." 20 60 1
    printf "\n"
    return
  fi

  rm -rf "$ADGUARD_TMP"

  if /opt/AdGuardHome/AdGuardHome -s install; then
    # Complete
    ADGUARD_WEB=$(get_web_addresses http 3000 | sed 's/\x1b\[[0-9;]*m//g')
    whiptail --title "Success" --msgbox "AdGuard Home has been installed.\n\nFinish setting up AdGuard Home via:\n\n$ADGUARD_WEB" 20 60 1
  else
    whiptail --title "Error" --msgbox "AdGuard Home failed to install correctly. Review log above." 20 60 1
  fi
  printf "\n"
  exit 0
}

do_extra_packages() {
  FUN=$(whiptail --title "Homebridge Raspberry Pi Configuration Tool (hb-config)" --menu "Advanced Options" $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT --cancel-button Back --ok-button Select \
    "A0 AdGuard Home" "Install / Uninstall AdGuard Home" \
    "A1 Pi-hole" "Install / Reconfigure Pi-hole" \
    3>&1 1>&2 2>&3)
  RET=$?
  if [ $RET -eq 1 ]; then
    return 0
  elif [ $RET -eq 0 ]; then
    case "$FUN" in
      A0\ *) do_install_adguard_home ;;
      A1\ *) do_install_pihole ;;
      *) whiptail --msgbox "Programmer error: unrecognized option" 20 60 1 ;;
    esac || whiptail --msgbox "There was an error running option $FUN" 20 60 1
  fi
}

# nginx 1.25.1 and newer want the line "http2 on;". Older versions (Debian 12 and before) do not
# know that line: they need "http2" on the "listen" lines. Returns 0 for the newer kind.
nginx_has_http2_setting() {
  NGINX_VERSION=$(nginx -v 2>&1 | sed -n 's#^nginx version: nginx/\([0-9][0-9.]*\).*#\1#p')
  [ -n "$NGINX_VERSION" ] && [ "$(printf '%s\n' "1.25.1" "$NGINX_VERSION" | sort -V | head -n 1)" = "1.25.1" ]
}

do_configure_nginx() {
  if ! whiptail --title "Warning" --yesno "Using this tool will overwrite any manual changes you may have made to the Homebridge Nginx config file.\n\nAre you sure you wish to continue?" 20 60 1; then
    return
  fi

  tempDir=$(mktemp -d) || return 1

  if ! whiptail --title "Homebridge Raspberry Pi Configuration Tool (hb-config)" --separate-output --checklist "\nNGINX Options:" 20 80 5 --cancel-button Cancel --ok-button Save \
    "1" "Listen on port 80 - http://        " 1 \
    "2" "Listen on port 443 - https://      " 1 \
    "3" "Redirect http:// to https://       " 0 2> "$tempDir/results"; then
    rm -rf "$tempDir"
    return
  fi

  LISTEN_ON_PORT_80=false
  LISTEN_ON_PORT_443=false
  REDIRECT_HTTP_TO_HTTPS=false

  while read -r choice; do
    case "$choice" in
      1) LISTEN_ON_PORT_80=true ;;
      2) LISTEN_ON_PORT_443=true ;;
      3) REDIRECT_HTTP_TO_HTTPS=true ;;
      *) ;;
    esac
  done < "$tempDir/results"

  rm -rf "$tempDir"

  NGINX_PORT_80_CONFIG=""
  if [ "$LISTEN_ON_PORT_80" = "true" ]; then
    NGINX_PORT_80_CONFIG="# http://
  listen 80;                  # http IPv4
  listen [::]:80;             # http IPv6
"
  fi

  NGINX_PORT_443_CONFIG=""
  if [ "$LISTEN_ON_PORT_443" = "true" ]; then
    if nginx_has_http2_setting; then
      NGINX_PORT_443_CONFIG="# https://
  listen 443 ssl;             # https IPv4
  listen [::]:443 ssl;        # https IPv6
  http2 on;
"
    else
      NGINX_PORT_443_CONFIG="# https://
  listen 443 ssl http2;       # https IPv4
  listen [::]:443 ssl http2;  # https IPv6
"
    fi
  fi

  NGINX_REDIRECT_HTTP_TO_HTTPS=""
  if [ "$REDIRECT_HTTP_TO_HTTPS" = "true" ] && [ "$LISTEN_ON_PORT_80" = "true" ]; then
    NGINX_PORT_80_CONFIG=""
    NGINX_REDIRECT_HTTP_TO_HTTPS="
server {
  listen 80;                  # http IPv4
  listen [::]:80;             # http IPv6

  # replace the _ with your domain name if required
  # eg.
  # server_name example.com;
  server_name _;

  return 302 https://\$host\$request_uri;
}"
  fi

  # the port of the Homebridge UI: digits only, or the default
  UI_PORT=$(cat /etc/hb-ui-port 2> /dev/null)
  case "$UI_PORT" in
    "" | *[!0-9]*) UI_PORT=8581 ;;
  esac

  NGINX_TEMPLATE="# this file was generated using the hb-config tool

server {
  $NGINX_PORT_80_CONFIG
  $NGINX_PORT_443_CONFIG
  # replace the _ with your domain name if required
  # eg.
  # server_name example.com;
  server_name _; # replace with your domain

  # path to ssl certificate file
  # If using Let's Encrypt replace this path with the location of the fullchain.pem file for your domain
  # eg.
  # ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
  ssl_certificate /etc/nginx/ssl/homebridge.local.crt;

  # path to ssl private key file
  # If using Let's Encrypt replace this path with the location of the privkey.pem file for your domain
  # eg.
  # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
  ssl_certificate_key /etc/nginx/ssl/homebridge.local.key;

  ssl_session_cache           builtin:1000  shared:SSL:10m;
  ssl_protocols               TLSv1.2 TLSv1.3;
  ssl_ciphers                 ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
  ssl_prefer_server_ciphers   off;
  # ssl_stapling                on;
  # ssl_stapling_verify         on;

  # large upload size to allow for uploading 3rd party backup files
  client_max_body_size 2G;

  error_page 502 /custom_502.html;

  location /startup-status.json {
    alias /usr/share/nginx/html/status.json;
  }

  location / {
    proxy_pass                  http://127.0.0.1:$UI_PORT;
    proxy_http_version          1.1;
    proxy_buffering             off;
    proxy_set_header            Host \$host;
    proxy_set_header            Upgrade \$http_upgrade;
    proxy_set_header            Connection \"Upgrade\";
    proxy_set_header            X-Real-IP \$remote_addr;
    proxy_set_header            X-Forwarded-For \$proxy_add_x_forwarded_for;
  }

  location = /custom_502.html {
    root /usr/share/nginx/html;
    internal;
  }
}
$NGINX_REDIRECT_HTTP_TO_HTTPS
"

  echo "$NGINX_TEMPLATE" > /etc/nginx/sites-available/homebridge.local
  /usr/local/sbin/nginx-homebridge-self-signed-cert
  systemctl enable nginx

  if systemctl is-active --quiet nginx.service; then
    echo "Restarting Nginx..."
    NGINX_ACTION=restart
  else
    echo "Starting Nginx..."
    NGINX_ACTION=start
  fi

  if systemctl "$NGINX_ACTION" nginx; then
    whiptail --title "Success" --msgbox "NGINX has been configured successfully." 20 60 1
  else
    whiptail --title "Error" --msgbox "An error occured while attempting to reload the NGINX config." 20 60 1
  fi
}

